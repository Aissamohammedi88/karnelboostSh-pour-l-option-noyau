# ═══════════════════════════════════════════════════════════════════════════

BENCH_AVANT_RAM=0
BENCH_AVANT_SWAP=0
BENCH_AVANT_DISK=0
BENCH_AVANT_LOAD=0
BENCH_AVANT_PROCS=0
BENCH_AVANT_TIME=0

benchmark_avant() {
title "📊 BENCHMARK — ÉTAT INITIAL"

BENCH_AVANT_RAM=$(free 2>/dev/null | awk '/^Mem:/ {printf "%.1f", $3/$2*100}')
BENCH_AVANT_SWAP=$(free 2>/dev/null | awk '/^Swap:/ {printf "%.1f", $3/$2*100}')
BENCH_AVANT_DISK=$(df / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%')
BENCH_AVANT_LOAD=$(cat /proc/loadavg 2>/dev/null | awk '{print $1}')
BENCH_AVANT_PROCS=$(ps aux 2>/dev/null | wc -l)
BENCH_AVANT_TIME=$(date +%s)

printf " ${C_CYAN}RAM utilisée${C_RESET} : ${C_YELLOW}%s%%${C_RESET}\n" "$BENCH_AVANT_RAM"
printf " ${C_CYAN}Swap utilisé${C_RESET} : ${C_YELLOW}%s%%${C_RESET}\n" "$BENCH_AVANT_SWAP"
printf " ${C_CYAN}Disque utilisé${C_RESET} : ${C_YELLOW}%s%%${C_RESET}\n" "$BENCH_AVANT_DISK"
printf " ${C_CYAN}Load average${C_RESET} : %s\n" "$BENCH_AVANT_LOAD"
printf " ${C_CYAN}Processus${C_RESET} : %s\n" "$BENCH_AVANT_PROCS"
echo ""

log_action "benchmark_avant : RAM=${BENCH_AVANT_RAM}% DISK=${BENCH_AVANT_DISK}%"
}

benchmark_apres() {
title "📊 BENCHMARK — ÉTAT FINAL"

local apres_ram apres_disk apres_procs apres_time
apres_ram=$(free 2>/dev/null | awk '/^Mem:/ {printf "%.1f", $3/$2*100}')
apres_disk=$(df / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%')
apres_procs=$(ps aux 2>/dev/null | wc -l)
apres_time=$(date +%s)

printf " ${C_CYAN}RAM utilisée${C_RESET} : %s%%\n" "$apres_ram"
printf " ${C_CYAN}Disque utilisé${C_RESET} : %s%%\n" "$apres_disk"
printf " ${C_CYAN}Processus${C_RESET} : %s\n" "$apres_procs"
echo ""

local gain_ram gain_disk duree
gain_ram=$(python3 -c "print(f'{$BENCH_AVANT_RAM - $apres_ram:.1f}')" 2>/dev/null || echo "0")
gain_disk=$((BENCH_AVANT_DISK - apres_disk))
duree=$((apres_time - BENCH_AVANT_TIME))

title "📈 GAINS MESURÉS"
printf " ${C_CYAN}RAM${C_RESET} : ${C_YELLOW}%s%%${C_RESET} → %s%% (gain : ${C_GREEN}%s pts${C_RESET})\n" \
"$BENCH_AVANT_RAM" "$apres_ram" "$gain_ram"
printf " ${C_CYAN}Disque${C_RESET} : ${C_YELLOW}%s%%${C_RESET} → %s%% (gain : ${C_GREEN}%s pts${C_RESET})\n" \
"$BENCH_AVANT_DISK" "$apres_disk" "$gain_disk"
printf " ${C_CYAN}Durée${C_RESET} : ${C_GREEN}%ss${C_RESET}\n" "$duree"
echo ""

log_action "benchmark_apres : RAM=${apres_ram}% DISK=${apres_disk}% DUREE=${duree}s"
}

benchmark_cpu() {
title "⚡ BENCHMARK CPU"

if ! is_command bc && ! is_command python3; then
log_warn "bc ou python3 requis pour benchmark CPU"
return
fi

subheading "Test calcul intensif (100 000 itérations)"

timer_start
local resultat=0
local i
for i in $(seq 1 100000); do
resultat=$((resultat + i % 7))
done
local duree
duree=$(timer_stop)

log_ok "Calcul terminé en ${duree}s (résultat=$resultat)"
echo ""

subheading "Test I/O disque"

local test_file="$CACHE_DIR/disk_test_$$"
mkdir -p "$CACHE_DIR"

timer_start
dd if=/dev/zero of="$test_file" bs=1M count=100 2>/dev/null
local duree_ecriture
duree_ecriture=$(timer_stop)

timer_start
dd if="$test_file" of=/dev/null bs=1M 2>/dev/null
local duree_lecture
duree_lecture=$(timer_stop)

rm -f "$test_file"

printf " Écriture 100 Mo : %ss\n" "$duree_ecriture"
printf " Lecture 100 Mo : %ss\n" "$duree_lecture"
echo ""
}

# ═══════════════════════════════════════════════════════════════════════════
# SECTION 16 — AUDIT SÉCURITÉ
# ═══════════════════════════════════════════════════════════════════════════

audit_securite() {
title "🔒 AUDIT SÉCURITÉ"

local score=100
local problemes=0

# 1. Vérifier utilisateurs sans mot de passe
subheading "Utilisateurs système"
if [ -f /etc/shadow ]; then
local users_sans_pass
users_sans_pass=$(sudo awk -F: '($2==""){print $1}' /etc/shadow 2>/dev/null | head -5)
if [ -n "$users_sans_pass" ]; then
log_warn "Utilisateurs sans mot de passe : $users_sans_pass"
score=$((score - 20))
problemes=$((problemes + 1))
else
log_ok "Tous les utilisateurs ont un mot de passe"
fi
fi

# 2. Vérifier SSH
echo ""
subheading "SSH"
if [ -f /etc/ssh/sshd_config ]; then
if grep -q "^PermitRootLogin yes" /etc/ssh/sshd_config 2>/dev/null; then
log_warn "SSH : root login autorisé"
score=$((score - 15))
problemes=$((problemes + 1))
else
log_ok "SSH : root login désactivé"
fi

if grep -q "^PasswordAuthentication yes" /etc/ssh/sshd_config 2>/dev/null; then
log_warn "SSH : authentification par mot de passe activée"
score=$((score - 10))
problemes=$((problemes + 1))
fi
else
log_ok "SSH non installé"
fi

# 3. Vérifier firewall
echo ""
subheading "Firewall"
if is_command ufw; then
if sudo ufw status 2>/dev/null | grep -q "Status: active"; then
log_ok "UFW actif"
else
log_warn "UFW installé mais inactif"
score=$((score - 10))
problemes=$((problemes + 1))
fi
elif is_command firewall-cmd; then
if sudo firewall-cmd --state 2>/dev/null | grep -q "running"; then
log_ok "Firewalld actif"
else
log_warn "Firewalld inactif"
score=$((score - 10))
problemes=$((problemes + 1))
fi
else
log_warn "Aucun firewall détecté"
score=$((score - 10))
problemes=$((problemes + 1))
fi

# 4. Vérifier mises à jour
echo ""
subheading "Mises à jour"
case "$DISTRO_FAMILY" in
debian)
local updates
updates=$(apt list --upgradable 2>/dev/null | grep -c upgradable || echo "0")
if [ "$updates" -gt 0 ]; then
log_warn "$updates paquets à mettre à jour"
score=$((score - 5))
problemes=$((problemes + 1))
else
log_ok "Système à jour"
fi
;;
arch)
log_info "Vérifier avec pacman -Syu manuellement"
;;
redhat)
local updates
updates=$(dnf check-update 2>/dev/null | grep -c "^[a-z]" || echo "0")
if [ "$updates" -gt 0 ]; then
log_warn "$updates paquets à mettre à jour"
score=$((score - 5))
problemes=$((problemes + 1))
fi
;;
esac

# 5. Vérifier ports ouverts
echo ""
subheading "Ports en écoute"
if is_command ss; then
local ports_ouverts
ports_ouverts=$(ss -tlnp 2>/dev/null | grep LISTEN | wc -l)
printf " %s ports en écoute\n" "$ports_ouverts"
fi

# Score final
echo ""
title "📊 SCORE SÉCURITÉ"

if [ "$score" -ge 90 ]; then
log_ok "Score : $score/100 — Excellent"
elif [ "$score" -ge 70 ]; then
log_warn "Score : $score/100 — Bon"
elif [ "$score" -ge 50 ]; then
log_warn "Score : $score/100 — Moyen ($problemes problèmes)"
else
log_error "Score : $score/100 — Faible ($problemes problèmes)"
fi

log_action "audit_securite : score=$score problemes=$problemes"
}

# ═══════════════════════════════════════════════════════════════════════════
# SECTION 17 — NETTOYAGE DISQUE
# ═══════════════════════════════════════════════════════════════════════════

action_clean() {
title "🧹 NETTOYAGE DISQUE"

local avant
avant=$(df / 2>/dev/null | awk 'NR==2 {print $4}')

if [ "$DRY_RUN" -eq 1 ]; then
log_info "[DRY-RUN] Simulation du nettoyage"
fi

# 1. Cache APT
case "$DISTRO_FAMILY" in
debian)
subheading "Cache APT"
if safe_sudo apt clean; then
log_ok "apt clean terminé"
fi
if safe_sudo apt autoclean; then
log_ok "apt autoclean terminé"
fi
;;
arch)
subheading "Cache pacman"
safe_sudo pacman -Sc --noconfirm 2>/dev/null && log_ok "pacman clean"
;;
redhat)
subheading "Cache DNF"
safe_sudo dnf clean all 2>/dev/null && log_ok "dnf clean"
;;
esac

# 2. Autoremove
if [ "$DISTRO_FAMILY" = "debian" ]; then
echo ""
subheading "Paquets orphelins"
safe_sudo apt autoremove --purge -y 2>/dev/null | tail -3
log_ok "Autoremove terminé"
fi

# 3. Journal systemd
if is_command journalctl; then
echo ""
subheading "Journal systemd"
safe_sudo journalctl --vacuum-size=100M 2>/dev/null
log_ok "Journal réduit à 100M max"
fi

# 4. Caches utilisateur
echo ""
subheading "Caches utilisateur"

local caches=(
"$HOME/.cache"
"$HOME/.local/share/Trash"
"$HOME/.thumbnails"
"$HOME/.cache/pip"
"$HOME/.npm"
"$HOME/.cargo/registry/cache"
"$HOME/.gradle/caches"
)

for cache in "${caches[@]}"; do
if [ -d "$cache" ]; then
local taille
taille=$(du -sh "$cache" 2>/dev/null | cut -f1)
log_info "Suppression : $cache ($taille)"
rm -rf "$cache"/* 2>/dev/null
fi
done
log_ok "Caches utilisateur nettoyés"

# 5. Résultat
local apres
apres=$(df / 2>/dev/null | awk 'NR==2 {print $4}')
local gain_bytes=$((apres - avant))
local gain_h
gain_h=$(human_size "$gain_bytes")

echo ""
log_ok "Espace libéré : $gain_h"

log_action "clean : gain=$gain_h"
}

# ═══════════════════════════════════════════════════════════════════════════
# SECTION 18 — OPTIMISATION NOYAU
# ═══════════════════════════════════════════════════════════════════════════

action_kernel() {
title "⚙️ OPTIMISATION NOYAU"

if [ "$SUDO_OK" != "1" ]; then
log_warn "sudo requis — optimisation noyau ignorée"
return
fi

subheading "Paramètres noyau"

local params=(
"vm.swappiness=10"
"vm.vfs_cache_pressure=50"
"vm.dirty_ratio=15"
"vm.dirty_background_ratio=5"
)

for p in "${params[@]}"; do
local key="${p%=*}"
local val="${p#*=}"
if safe_sudo sysctl -w "$p" >/dev/null 2>&1; then
log_ok "sysctl $key=$val"
fi
done

# Persistance
echo ""
subheading "Persistance"

if [ "$DRY_RUN" -eq 0 ]; then
safe_sudo tee /etc/sysctl.d/99-nexus-speedup.conf >/dev/null <<'SYSCTL'
# NEXUS SPEEDUP — Optimisations noyau
vm.swappiness=10
vm.vfs_cache_pressure=50
vm.dirty_ratio=15
vm.dirty_background_ratio=5
SYSCTL
log_ok "Persistance : /etc/sysctl.d/99-nexus-speedup.conf"
fi

log_action "kernel : paramètres appliqués"
}

