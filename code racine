# SECTION 31 — PARSER CLI
# ═══════════════════════════════════════════════════════════════════════════

parser_args() {
while [ $# -gt 0 ]; do
case "$1" in
-h|--help)
usage
exit 0
;;
-v|--version)
echo "$SCRIPT_NAME v$SCRIPT_VERSION ($SCRIPT_BUILD)"
exit 0
;;
-p|--port)
shift
[ -z "${1:-}" ] && log_fatal "Option --port requiert une valeur"
DASHBOARD_PORT="$1"
shift
;;
-t|--token)
shift
[ -z "${1:-}" ] && log_fatal "Option --token requiert une valeur"
DASHBOARD_TOKEN="$1"
shift
;;
--no-browser)
NO_BROWSER=1
shift
;;
--no-color)
NO_COLOR=1
detecter_couleurs
shift
;;
--json)
JSON_OUTPUT=1
shift
;;
-q|--quiet)
QUIET=1
shift
;;
-d|--debug)
VERBOSE=1
LOG_LEVEL_THRESHOLD=$LOG_LEVEL_DEBUG
set -x
shift
;;
--dry-run)
DRY_RUN=1
log_warn "MODE DRY-RUN actif — aucune modification"
shift
;;
--install)
install_autostart
exit 0
;;
all|bench|clean|kernel|audit|services|network|hardware|backup|report|web)
COMMANDE="$1"
shift
;;
-*)
log_error "Option inconnue : $1"
usage
exit 1
;;
*)
log_error "Commande inconnue : $1"
usage
exit 1
;;
esac
done
}

executer_commande() {
case "${COMMANDE:-}" in
all) action_all ;;
bench) benchmark_avant; benchmark_cpu; benchmark_apres ;;
clean) action_clean ;;
kernel) action_kernel ;;
audit) audit_securite ;;
services) audit_services ;;
network) audit_reseau ;;
hardware) detecter_materiel ;;
backup) action_backup ;;
report) action_report ;;
web) action_web ;;
"") menu_interactif ;;
esac
}

