confirm() {
local prompt="$1"
local defaut="${2:-n}"

if [ "$DRY_RUN" -eq 1 ]; then
log_debug "[DRY-RUN] Confirmation auto : $prompt"
return 0
fi

local rep
if [ "$defaut" = "o" ] || [ "$defaut" = "O" ]; then
printf "${C_OR}%s${C_RESET} [O/n] : " "$prompt"
else
printf "${C_OR}%s${C_RESET} [o/N] : " "$prompt"
fi
read -r rep </dev/tty
rep="${rep:-$defaut}"
[ "$rep" = "o" ] || [ "$rep" = "O" ] || [ "$rep" = "y" ] || [ "$rep" = "Y" ]
}

human_size() {
local bytes="$1"
if command -v numfmt >/dev/null 2>&1; then
numfmt --to=iec-i --suffix=B "$bytes" 2>/dev/null || echo "$bytes B"
else
python3 -c "
b = $bytes
for u in ['B','Ki','Mi','Gi','Ti']:
if b < 1024: print(f'{b:.1f}{u}'); break
b /= 1024
" 2>/dev/null || echo "$bytes B"
}

timer_start() {
TIMER_START=$(date +%s%N 2>/dev/null || date +%s)
export TIMER_START
}

timer_stop() {
local end
end=$(date +%s%N 2>/dev/null || date +%s)
if [ ${#TIMER_START} -gt 10 ]; then
echo "scale=2; ($end - $TIMER_START) / 1000000000" | bc -l 2>/dev/null || echo "0"
else
echo "$((end - TIMER_START))"
fi
}

