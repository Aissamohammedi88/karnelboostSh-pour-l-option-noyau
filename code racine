lire_config() {
local key="$1"
local defaut="${2:-}"

if [ ! -f "$CONFIG_FILE" ]; then
printf '%s' "$defaut"
return
fi

if command -v jq >/dev/null 2>&1; then
local val
val=$(jq -r ".$key // \"$defaut\"" "$CONFIG_FILE" 2>/dev/null)
printf '%s' "${val:-$defaut}"
elif command -v python3 >/dev/null 2>&1; then
python3 -c "
import json
try:
d = json.load(open('$CONFIG_FILE'))
v = d
for k in '$key'.split('.'):
v = v.get(k, '$defaut')
print(v)
except: print('$defaut')
" 2>/dev/null
else
printf '%s' "$defaut"
fi
}

