# SECTION 21 — BACKUP
# ═══════════════════════════════════════════════════════════════════════════

action_backup() {
title "💾 BACKUP CONFIGURATIONS"

local ts
ts=$(date +%Y%m%d_%H%M%S)
local backup_path="$BACKUP_DIR/backup_$ts"
mkdir -p "$backup_path"

local fichiers=(
"/etc/fstab"
"/etc/apt/sources.list"
"/etc/sysctl.conf"
"/etc/hosts"
"$HOME/.bashrc"
"$HOME/.profile"
"$CONFIG_FILE"
)

for f in "${fichiers[@]}"; do
if [ -f "$f" ]; then
local dst="$backup_path/$(basename "$f")"
if [[ "$f" == /etc/* ]]; then
safe_sudo cp "$f" "$dst" 2>/dev/null
else
cp "$f" "$dst" 2>/dev/null
fi
[ -f "$dst" ] && log_ok "Sauvegardé : $f"
fi
done

# Manifeste
cat > "$backup_path/MANIFEST.txt" <<EOF
NEXUS BACKUP
============
Date : $(date)
Hostname : $(hostname)
Kernel : $(uname -r)
Distribution: $DISTRO_NAME
Auteur : $SCRIPT_AUTEUR
Version : $SCRIPT_VERSION
Backup ID : $ts
EOF

log_ok "Backup : $backup_path"
log_action "backup : $backup_path"

# Rotation : garder 10 backups
local count
count=$(find "$BACKUP_DIR" -maxdepth 1 -type d -name "backup_*" 2>/dev/null | wc -l)
if [ "$count" -gt 10 ]; then
find "$BACKUP_DIR" -maxdepth 1 -type d -name "backup_*" 2>/dev/null | \
sort | head -n -10 | xargs -r rm -rf
log_info "Rotation backups : >10 supprimés"
fi
}

# ═══════════════════════════════════════════════════════════════════════════
# SECTION 22 — RAPPORT JSON
# ═══════════════════════════════════════════════════════════════════════════

action_report() {
title "📄 GÉNÉRATION RAPPORT"

mkdir -p "$REPORT_DIR"
local ts
ts=$(date +%Y%m%d_%H%M%S)
local report="$REPORT_DIR/rapport_$ts.json"

local ram_pct disk_pct load procs cpu_cores ram_total disk_total uptime_val kernel
ram_pct=$(free 2>/dev/null | awk '/^Mem:/ {printf "%.1f", $3/$2*100}')
disk_pct=$(df / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%')
load=$(cat /proc/loadavg 2>/dev/null | awk '{print $1}')
procs=$(ps aux 2>/dev/null | wc -l)
cpu_cores=$(nproc 2>/dev/null || echo "1")
ram_total=$(free -h 2>/dev/null | awk '/^Mem:/ {print $2}')
disk_total=$(df -h / 2>/dev/null | awk 'NR==2 {print $2}')
uptime_val=$(uptime -p 2>/dev/null || uptime)
kernel=$(uname -r)

local erreurs_json warnings_json actions_json
erreurs_json=$(printf '%s\n' "${RAPPORT_ERREURS[@]:-}" | \
python3 -c "import sys,json; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))" 2>/dev/null || echo "[]")
warnings_json=$(printf '%s\n' "${RAPPORT_WARNINGS[@]:-}" | \
python3 -c "import sys,json; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))" 2>/dev/null || echo "[]")
actions_json=$(printf '%s\n' "${RAPPORT_ACTIONS[@]:-}" | \
python3 -c "import sys,json; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))" 2>/dev/null || echo "[]")

cat > "$report" <<JSONEOF
{
"version": "$SCRIPT_VERSION",
"auteur": "$SCRIPT_AUTEUR",
"protocole": "$SCRIPT_PROTOCOLE",
"licence": "$SCRIPT_LICENCE",
"timestamp": "$(date -Iseconds)",
"hostname": "$(hostname)",
"kernel": "$kernel",
"distribution": {
"name": "$DISTRO_NAME",
"family": "$DISTRO_FAMILY",
"id": "$DISTRO"
},
"system": {
"cpu": {"cores": $cpu_cores, "load_avg": "$load"},
"ram": {"total": "$ram_total", "percent_used": "$ram_pct"},
"disk": {"total": "$disk_total", "percent_used": "$disk_pct"},
"processes": $procs,
"uptime": "$uptime_val"
},
"results": {
"erreurs": $erreurs_json,
"warnings": $warnings_json,
"actions": $actions_json
},
"meta": {
"dry_run": $([ "$DRY_RUN" -eq 1 ] && echo "true" || echo "false"),
"sudo_ok": $([ "$SUDO_OK" -eq 1 ] && echo "true" || echo "false")
}
}
JSONEOF

log_ok "Rapport : $report"

if [ "$JSON_OUTPUT" -eq 0 ]; then
subheading "Aperçu"
head -30 "$report"
fi

log_action "report : $report"
}

