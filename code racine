# SECTION 6 — GESTION SIGNAUX & CLEANUP
# ═══════════════════════════════════════════════════════════════════════════

CLEANUP_EN_COURS=0

on_signal_int() {
[ "$CLEANUP_EN_COURS" -eq 1 ] && return
CLEANUP_EN_COURS=1
echo ""
log_warn "Interruption (SIGINT) — nettoyage..."
cleanup_global
exit 130
}

on_signal_term() {
[ "$CLEANUP_EN_COURS" -eq 1 ] && return
CLEANUP_EN_COURS=1
log_warn "Terminaison (SIGTERM) — nettoyage..."
cleanup_global
exit 143
}

cleanup_global() {
# Tuer jobs enfants
local jobs_list
jobs_list=$(jobs -p 2>/dev/null)
if [ -n "$jobs_list" ]; then
echo "$jobs_list" | xargs -r kill 2>/dev/null
fi
# Supprimer lock
[ -f "$LOCK_FILE" ] && rm -f "$LOCK_FILE" 2>/dev/null
log_debug "Cleanup terminé"
}

trap on_signal_int INT
trap on_signal_term TERM
trap cleanup_global EXIT

# ═══════════════════════════════════════════════════════════════════════════
# SECTION 7 — LOCKING (empêche double exécution)
# ═══════════════════════════════════════════════════════════════════════════

acquire_lock() {
mkdir -p "$STATE_DIR" 2>/dev/null
if [ -f "$LOCK_FILE" ]; then
local pid_existant
pid_existant=$(cat "$LOCK_FILE" 2>/dev/null)
if [ -n "$pid_existant" ] && kill -0 "$pid_existant" 2>/dev/null; then
log_fatal "Instance déjà active (PID $pid_existant)"
else
log_warn "Lock orphelin détecté, suppression"
rm -f "$LOCK_FILE"
fi
fi
echo "$SCRIPT_PID" > "$LOCK_FILE"
log_debug "Lock acquis : $LOCK_FILE"
}

release_lock() {
[ -f "$LOCK_FILE" ] && rm -f "$LOCK_FILE"
log_debug "Lock libéré"
}

