# SECTION 24 — GÉNÉRATION SERVEUR PYTHON
# ═══════════════════════════════════════════════════════════════════════════

generer_serveur() {
local fichier="$BASE_DIR/server.py"

cat > "$fichier" <<'PYEOF'
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import os, sys, json, time, socket, shutil, subprocess, urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from datetime import datetime

BASE = os.path.expanduser("~/Documents/nexus_suite")
HTML_FILE = os.path.join(BASE, "dashboard.html")
SCRIPT = os.path.expanduser("~/nexus_suite.sh")

def get_stats():
stats = {"ram": {}, "disk": {}, "cpu": {}, "uptime": "", "hostname": ""}
try:
with open("/proc/meminfo") as f:
d = {l.split(":")[0]: int(l.split(":")[1].split()[0]) for l in f if ":" in l}
total = d["MemTotal"] / 1024 / 1024
avail = d.get("MemAvailable", 0) / 1024 / 1024
used = total - avail
stats["ram"] = {"total": f"{total:.1f} Gi", "used": f"{used:.1f} Gi",
"percent": round(used / total * 100, 1)}
except:
stats["ram"] = {"total": "?", "used": "?", "percent": 0}
try:
d = shutil.disk_usage("/")
total = d.total / 1024**3
used = d.used / 1024**3
stats["disk"] = {"total": f"{total:.1f} G", "used": f"{used:.1f} G",
"percent": round(used / total * 100, 1)}
except:
stats["disk"] = {"total": "?", "used": "?", "percent": 0}
try:
with open("/proc/loadavg") as f:
load = float(f.read().split()[0])
cores = os.cpu_count() or 1
stats["cpu"] = {"cores": cores, "load": round(load, 2),
"percent": round(load / cores * 100, 1)}
except:
stats["cpu"] = {"cores": 1, "load": 0, "percent": 0}
try:
with open("/proc/uptime") as f:
s = float(f.read().split()[0])
stats["uptime"] = f"{int(s//86400)}j {int((s%86400)//3600)}h {int((s%3600)//60)}m"
except:
stats["uptime"] = "?"
stats["hostname"] = socket.gethostname()
return stats

def run_action(cmd):
allowed = ["all", "bench", "clean", "kernel", "audit",
"services", "network", "hardware", "backup", "report"]
if cmd not in allowed:
return {"success": False, "output": "Action non autorisee : " + cmd}
try:
start = time.time()
r = subprocess.run(["bash", SCRIPT, cmd],
capture_output=True, text=True, timeout=600)
return {"success": r.returncode == 0,
"output": r.stdout + "\n" + r.stderr,
"duration": round(time.time() - start, 2)}
except subprocess.TimeoutExpired:
return {"success": False, "output": "Timeout 10 min"}
except Exception as e:
return {"success": False, "output": "Erreur : " + str(e)}

class Handler(BaseHTTPRequestHandler):
def log_message(self, *a):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8"):
if isinstance(body, str):
body = body.encode()
try:
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
self.wfile.write(body)
except:
pass

def _json(self, data, status=200):
self._send(status, json.dumps(data, ensure_ascii=False),
"application/json; charset=utf-8")

def do_GET(self):
p = urllib.parse.urlparse(self.path)
path = p.path
qs = urllib.parse.parse_qs(p.query)

if path in ("/", "/index.html"):
try:
with open(HTML_FILE, "rb") as f:
self._send(200, f.read())
except:
self._send(404, "Dashboard introuvable")
elif path == "/api/stats":
self._json(get_stats())
elif path == "/api/action":
cmd = qs.get("cmd", [""])[0]
self._json(run_action(cmd))
elif path == "/health":
self._json({"status": "ok"})
elif path == "/api/version":
self._json({"version": "4.0.0", "author": "Aissa Mohammedi (DGK)"})
else:
self._send(404, "404")

def main():
port = int(sys.argv[1]) if len(sys.argv) > 1 else 9999
local_ip = "127.0.0.1"
try:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.settimeout(2)
s.connect(("8.8.8.8", 80))
local_ip = s.getsockname()[0]
s.close()
except:
pass

print("")
print("=====================================================")
print(" NEXUS SYSTEM SUITE v4.0.0 - SERVEUR ACTIF")
print("=====================================================")
print("")
print(" Local : http://localhost:" + str(port) + "/")
print(" Reseau : http://" + local_ip + ":" + str(port) + "/")
print(" Stats : http://localhost:" + str(port) + "/api/stats")
print("")
print(" Ctrl+C pour arreter")
print("")

try:
server = ThreadingHTTPServer(("0.0.0.0", port), Handler)
server.daemon_threads = True
server.serve_forever()
except KeyboardInterrupt:
print("")
print("Arrete.")
except OSError as e:
print("Erreur port " + str(port) + " : " + str(e))
sys.exit(1)

if __name__ == "__main__":
main()
PYEOF

chmod +x "$fichier"
log_debug "Serveur généré : $fichier"
}

