<script>
function log(msg, type){
type = type || 'info';
const term = document.getElementById('terminal');
const time = new Date().toLocaleTimeString('fr-FR');
const div = document.createElement('div');
div.className = 'log-line log-' + type;
div.innerHTML = '<span class="log-time">[' + time + ']</span> ' + esc(msg);
term.appendChild(div);
term.scrollTop = term.scrollHeight;
while (term.children.length > 200) term.removeChild(term.firstChild);
}
function esc(s){
const d = document.createElement('div');
d.textContent = String(s);
return d.innerHTML;
}
let running = false;
async function action(cmd){
if (running) { log('Action en cours', 'warn'); return; }
running = true;
const pill = document.getElementById('console-pill');
pill.textContent = 'running';
pill.classList.add('running');
log('▶ ' + cmd, 'info');
document.querySelectorAll('.btn').forEach(b => b.disabled = true);
try {
const res = await fetch('/api/action?cmd=' + encodeURIComponent(cmd));
const data = await res.json();
if (data.output) {
data.output.split('\n').forEach(line => {
if (!line.trim()) return;
let t = 'info';
if (line.includes('[OK]')) t = 'ok';
else if (line.includes('[ERR]')) t = 'err';
else if (line.includes('[WARN]')) t = 'warn';
log(line.trim(), t);
});
}
log(data.success ? '✅ Terminé' : '❌ Échec', data.success ? 'ok' : 'err');
pill.textContent = 'idle';
pill.classList.remove('running');
} catch(e) {
log('Erreur : ' + e.message, 'err');
pill.textContent = 'error';
pill.classList.remove('running');
} finally {
document.querySelectorAll('.btn').forEach(b => b.disabled = false);
running = false;
refreshStats();
}
}
async function refreshStats(){
try {
const res = await fetch('/api/stats');
const d = await res.json();
document.getElementById('ram-value').textContent = d.ram.percent + '%';
document.getElementById('ram-detail').textContent = d.ram.used + ' / ' + d.ram.total;
const rb = document.getElementById('ram-bar');
rb.style.width = d.ram.percent + '%';
rb.className = 'progress-fill ' + (d.ram.percent > 80 ? 'red' : d.ram.percent > 60 ? 'yellow' : 'green');
document.getElementById('disk-value').textContent = d.disk.percent + '%';
document.getElementById('disk-detail').textContent = d.disk.used + ' / ' + d.disk.total;
const db = document.getElementById('disk-bar');
db.style.width = d.disk.percent + '%';
db.className = 'progress-fill ' + (d.disk.percent > 90 ? 'red' : d.disk.percent > 70 ? 'yellow' : 'green');
document.getElementById('cpu-value').textContent = d.cpu.percent + '%';
document.getElementById('cpu-detail').textContent = d.cpu.cores + ' cores · ' + d.cpu.load;
const cb = document.getElementById('cpu-bar');
cb.style.width = Math.min(d.cpu.percent, 100) + '%';
cb.className = 'progress-fill ' + (d.cpu.percent > 80 ? 'red' : d.cpu.percent > 60 ? 'yellow' : 'green');
document.getElementById('uptime-value').textContent = d.uptime;
document.getElementById('uptime-detail').textContent = d.hostname;
} catch(e) { console.error(e); }
}
document.addEventListener('keydown', e => {
if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
const k = e.key.toLowerCase();
if (k === '1') action('all');
else if (k === '3') action('clean');
else if (k === 'r') refreshStats();
});
refreshStats();
setInterval(refreshStats, 3000);
log('NEXUS SYSTEM SUITE v4.0.0 chargé', 'ok');
