# SECTION 19 — AUDIT SERVICES
# ═══════════════════════════════════════════════════════════════════════════

audit_services() {
title "🔍 AUDIT SERVICES"

if ! is_command systemctl; then
log_warn "systemctl non disponible"
return
fi

printf " %-28s %-12s %-12s\n" "Service" "Statut" "Mémoire"
sep_mini

local services=("snapd" "packagekit" "ModemManager" "cups-browsed"
"avahi-daemon" "bluetooth" "whoopsie" "apport"
"systemd-resolved" "NetworkManager" "wpa_supplicant"
"cron" "atd" "rsyslog")

for svc in "${services[@]}"; do
if systemctl is-active --quiet "$svc" 2>/dev/null; then
local mem
mem=$(systemctl show "$svc" --property=MemoryCurrent 2>/dev/null | cut -d= -f2)
if [ -n "$mem" ] && [ "$mem" != "[not set]" ]; then
mem=$(human_size "$mem" 2>/dev/null || echo "?")
else
mem="N/A"
fi
printf " %-28s ${C_RED}%-12s${C_RESET} %s\n" "$svc" "actif" "$mem"
else
printf " %-28s ${C_GREEN}%-12s${C_RESET}\n" "$svc" "inactif"
fi
done

echo ""
log_info "Désactiver : sudo systemctl disable <service>"
}

