verifier_prerequis() {
title "🔍 VÉRIFICATION DES PRÉREQUIS"

log_info "Distribution : $DISTRO_NAME"
log_info "Noyau : $(uname -r)"
log_info "Architecture : $(uname -m)"
log_info "Hostname : $(hostname)"

# Python 3
if is_command python3; then
log_ok "Python 3 : $(python3 --version 2>&1 | head -1)"
else
log_fatal "Python 3 introuvable — requis"
fi

# Commandes critiques
local critiques=("awk" "sed" "grep" "ps" "df" "free" "uptime")
local manquantes_critiques=()

for cmd in "${critiques[@]}"; do
if ! is_command "$cmd"; then
manquantes_critiques+=("$cmd")
fi
done

if [ ${#manquantes_critiques[@]} -gt 0 ]; then
log_fatal "Commandes critiques manquantes : ${manquantes_critiques[*]}"
fi
log_ok "Toutes les commandes critiques présentes"

# Commandes optionnelles
local optionnelles=("jq" "bc" "curl" "wget" "ss" "lscpu" "lspci" "lsblk")
for cmd in "${optionnelles[@]}"; do
if is_command "$cmd"; then
log_debug "Optionnel présent : $cmd"
else
log_debug "Optionnel absent : $cmd"
fi
done

# Espace disque
local disk_pct
disk_pct=$(df / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%')
if [ -n "$disk_pct" ] && [ "$disk_pct" -gt 90 ]; then
log_warn "Disque à ${disk_pct}% — nettoyage urgent"
else
log_ok "Disque : ${disk_pct}% utilisé"
fi

# RAM
local ram_pct
ram_pct=$(free 2>/dev/null | awk '/^Mem:/ {printf "%.0f", $3/$2*100}')
if [ -n "$ram_pct" ] && [ "$ram_pct" -gt 80 ]; then
log_warn "RAM à ${ram_pct}% — optimisation recommandée"
else
log_ok "RAM : ${ram_pct}% utilisée"
fi

echo ""
}

