main() {
COMMANDE=""

parser_args "$@"

init_logger
detecter_distribution

if [ -n "$COMMANDE" ] || [ -n "${COMMANDE:-}" ]; then
banniere
log_info "Commande : $COMMANDE"
fi

verifier_sudo
creer_config_defaut
verifier_prerequis
rotate_logs
acquire_lock

log_info "==========================================="
log_info "NEXUS SYSTEM SUITE v$SCRIPT_VERSION"
log_info "Distribution : $DISTRO_NAME"
log_info "Kernel : $(uname -r)"
log_info "sudo : $([ "$SUDO_OK" -eq 1 ] && echo "OK" || echo "NON")"
log_info "dry-run : $([ "$DRY_RUN" -eq 1 ] && echo "OUI" || echo "NON")"
log_info "==========================================="

executer_commande

release_lock

if [ -n "$COMMANDE" ]; then
afficher_bilan
fi
}

main "$@"

