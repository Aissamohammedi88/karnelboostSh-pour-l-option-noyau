audit_reseau() {
title "🌐 ANALYSE RÉSEAU"

subheading "Interfaces"
if is_command ip; then
ip -br addr 2>/dev/null | while read -r line; do
printf " %s\n" "$line"
done
fi

echo ""
subheading "Ports en écoute"
if is_command ss; then
ss -tlnp 2>/dev/null | head -15 | while read -r line; do
printf " %s\n" "$line"
done
fi

echo ""
subheading "Connexions actives"
if is_command ss; then
local nb_etablies
nb_etablies=$(ss -tn 2>/dev/null | grep -c ESTAB)
printf " Connexions établies : %s\n" "$nb_etablies"
fi

echo ""
subheading "DNS"
if [ -f /etc/resolv.conf ]; then
grep "nameserver" /etc/resolv.conf 2>/dev/null | while read -r line; do
printf " %s\n" "$line"
done
fi

echo ""
subheading "Test connectivité"
if is_command ping; then
if ping -c 2 -W 2 8.8.8.8 >/dev/null 2>&1; then
log_ok "Internet accessible"
else
log_warn "Pas d'accès Internet"
fi
fi
}

