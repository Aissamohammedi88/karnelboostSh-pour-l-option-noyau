# SECTION 14 — DÉTECTION MATÉRIELLE
# ═══════════════════════════════════════════════════════════════════════════

detecter_materiel() {
title "🖥️ DÉTECTION MATÉRIELLE"

# CPU
subheading "CPU"
if [ -f /proc/cpuinfo ]; then
local cpu_model cpu_cores
cpu_model=$(grep "model name" /proc/cpuinfo | head -1 | cut -d: -f2 | xargs)
cpu_cores=$(nproc 2>/dev/null || echo "?")
printf " Modèle : %s\n" "${cpu_model:-Inconnu}"
printf " Cœurs : %s\n" "$cpu_cores"
printf " Threads : %s\n" "$(grep -c "^processor" /proc/cpuinfo)"
fi

# RAM
echo ""
subheading "Mémoire"
local ram_total ram_used ram_free swap_total
ram_total=$(free -h 2>/dev/null | awk '/^Mem:/ {print $2}')
ram_used=$(free -h 2>/dev/null | awk '/^Mem:/ {print $3}')
ram_free=$(free -h 2>/dev/null | awk '/^Mem:/ {print $4}')
swap_total=$(free -h 2>/dev/null | awk '/^Swap:/ {print $2}')
printf " RAM totale : %s\n" "${ram_total:-?}"
printf " RAM utilisée: %s\n" "${ram_used:-?}"
printf " RAM libre : %s\n" "${ram_free:-?}"
printf " Swap total : %s\n" "${swap_total:-?}"

# Disque
echo ""
subheading "Disque"
df -h 2>/dev/null | awk 'NR==1 || /^\/dev/' | while read -r line; do
printf " %s\n" "$line"
done

# GPU (optionnel)
echo ""
subheading "GPU"
if is_command lspci; then
local gpu_info
gpu_info=$(lspci 2>/dev/null | grep -i "vga\|3d\|display" | head -3)
if [ -n "$gpu_info" ]; then
echo "$gpu_info" | while read -r line; do
printf " %s\n" "$line"
done
else
printf " Aucun GPU détecté\n"
fi
else
printf " lspci non disponible\n"
fi

# Carte réseau
echo ""
subheading "Réseau"
if is_command ip; then
ip -br link 2>/dev/null | while read -r line; do
printf " %s\n" "$line"
done
fi

echo ""
}

subheading() {
printf "\n${C_BOLD}${C_OR} %s${C_RESET}\n" "$1"
