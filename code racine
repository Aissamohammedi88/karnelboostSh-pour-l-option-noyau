# ═══════════════════════════════════════════════════════════════════════════
# SECTION 5 — SYSTÈME DE LOGGING PROFESSIONNEL
# ═══════════════════════════════════════════════════════════════════════════

LOG_FILE=""

init_logger() {
mkdir -p "$LOG_DIR" 2>/dev/null
LOG_FILE="$LOG_DIR/${SCRIPT_NAME}_$(date +%Y%m%d).log"
touch "$LOG_FILE" 2>/dev/null
}

_log_raw() {
local niveau="$1"
local msg="$2"
local ts
ts=$(date '+%Y-%m-%dT%H:%M:%S%z')

if [ -n "$LOG_FILE" ]; then
printf '[%s] [%-5s] [pid=%s] %s\n' \
"$ts" "$niveau" "$SCRIPT_PID" "$msg" >> "$LOG_FILE" 2>/dev/null
fi
}

_log_console() {
local niveau="$1"
local msg="$2"
local couleur="$3"

if [ "$QUIET" -eq 1 ] && [ "$niveau" != "ERR" ] && [ "$niveau" != "FATAL" ]; then
return
fi

if [ "$JSON_OUTPUT" -eq 1 ]; then
printf '{"ts":"%s","level":"%s","msg":"%s"}\n' \
"$(date -Iseconds)" "$niveau" "$(escape_json "$msg")"
else
printf "${couleur}[%s]${C_RESET} %s\n" "$niveau" "$msg"
fi
}

escape_json() {
local s="$1"
s="${s//\\/\\\\}"
s="${s//\"/\\\"}"
s="${s//$'\n'/\\n}"
s="${s//$'\r'/\\r}"
s="${s//$'\t'/\\t}"
printf '%s' "$s"
}

log_debug() {
[ "$LOG_LEVEL_THRESHOLD" -gt "$LOG_LEVEL_DEBUG" ] && return
_log_raw "DEBUG" "$1"
[ "$VERBOSE" -eq 1 ] && _log_console "DEBUG" "$1" "$C_DIM"
}

log_info() {
[ "$LOG_LEVEL_THRESHOLD" -gt "$LOG_LEVEL_INFO" ] && return
_log_raw "INFO" "$1"
_log_console "INFO" "$1" "$C_BLUE"
}

log_ok() {
[ "$LOG_LEVEL_THRESHOLD" -gt "$LOG_LEVEL_INFO" ] && return
_log_raw "OK" "$1"
_log_console "OK" "$1" "$C_GREEN"
}

log_warn() {
[ "$LOG_LEVEL_THRESHOLD" -gt "$LOG_LEVEL_WARN" ] && return
_log_raw "WARN" "$1"
_log_console "WARN" "$1" "$C_YELLOW"
RAPPORT_WARNINGS+=("$1")
}

log_error() {
[ "$LOG_LEVEL_THRESHOLD" -gt "$LOG_LEVEL_ERROR" ] && return
_log_raw "ERR" "$1"
_log_console "ERR" "$1" "$C_RED"
RAPPORT_ERREURS+=("$1")
}

log_fatal() {
_log_raw "FATAL" "$1"
_log_console "FATAL" "$1" "$C_RED"
RAPPORT_ERREURS+=("FATAL: $1")
exit 1
}

log_action() {
RAPPORT_ACTIONS+=("$1")
_log_raw "ACTION" "$1"
}

# Rotation logs : garde 14 jours
rotate_logs() {
find "$LOG_DIR" -name "${SCRIPT_NAME}_*.log" -mtime +14 -delete 2>/dev/null
log_debug "Rotation logs terminée"
}

