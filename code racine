# SECTION 9 — VERIFICATIONS SUDO
# ═══════════════════════════════════════════════════════════════════════════

verifier_sudo() {
if ! command -v sudo >/dev/null 2>&1; then
log_warn "sudo non installé — certaines actions seront limitées"
SUDO_OK=0
return
fi

if sudo -n true 2>/dev/null; then
SUDO_OK=1
log_debug "sudo : disponible sans mot de passe"
else
log_info "sudo : mot de passe requis"
if [ "$DRY_RUN" -eq 1 ]; then
SUDO_OK=0
return
fi
printf "${C_OR}Valider sudo maintenant ?${C_RESET} [o/N] : "
local rep
read -r rep </dev/tty
if [ "$rep" = "o" ] || [ "$rep" = "O" ]; then
if sudo -v 2>/dev/null; then
SUDO_OK=1
log_debug "sudo : validé"
else
SUDO_OK=0
log_warn "sudo : échec validation"
fi
else
SUDO_OK=0
fi
fi
}

# Wrapper sudo sécurisé
safe_sudo() {
if [ "$SUDO_OK" != "1" ]; then
log_warn "sudo indisponible — ignoré : $*"
return 1
fi
if [ "$DRY_RUN" -eq 1 ]; then
log_info "[DRY-RUN] sudo $*"
return 0
fi
sudo "$@"
}

